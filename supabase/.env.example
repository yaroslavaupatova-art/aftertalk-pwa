# Set with `supabase secrets set --env-file supabase/.env`.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Hosted Supabase injects SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS, and
# SUPABASE_SECRET_KEYS. Do not add reserved SUPABASE_* names to this upload file.

# Generate a unique value, for example: `openssl rand -hex 32`.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
RATE_LIMIT_MAX_REQUESTS=30

# Exact comma-separated browser origins. No wildcard values are accepted.
ALLOWED_ORIGINS=https://app.example.com
# Optional local development support; keep false in production.
ALLOW_LOCALHOST_ORIGINS=false

OPENAI_TIMEOUT_MS=30000
